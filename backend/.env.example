# StudyApp Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ===================================================
# Database
# ===================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=study_app
DB_USERNAME=root
DB_PASSWORD=your-mysql-password-here

# ===================================================
# JWT
# ===================================================
JWT_SECRET=replace-with-a-long-random-secret-string-minimum-64-characters
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ===================================================
# AI Provider
# ===================================================
AI_PROVIDER=openai
AI_API_KEY=your-openai-or-gemini-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096

# ===================================================
# Mail (for password reset — leave blank if not configured)
# ===================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_ENABLED=false

# ===================================================
# CORS
# ===================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
